# a and b assemble at the same time from an empty cache, so they shade the same libraries and write the same
# cache files at about the same time
> all a/assembly b/assembly
> a/checkJar
> b/checkJar
> checkCached

# b has nothing a didn't have, so assembling it again finds everything in the cache and writes nothing to it
> recordCache
> b/assembly
> checkCacheUnchanged
> b/checkJar
> b/keepCopy

# with the cache off, b gets the same entries
> set b / assemblyShadeCacheDirectory := None
> b/assembly
> b/checkJar
> b/checkSameAsCopy
